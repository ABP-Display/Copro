#: views_externalpayment.py:198
#, python-format
msgid ""
"\n"
"<html>\n"
"An online payment request was received in error in <i>Diacamma</i>.<br/>\n"
"<ul>\n"
" <li><u>Mode:</u> %(mode)s</li>\n"
" <li><u>Document:</u> %(doc)s</li>\n"
" <li><u>Date:</u> %(date)s</li>\n"
" <li><u>Amount:</u> %(amount)s</li>\n"
" <li><u>Payer:</u> %(payer)s</li>\n"
"<ul>\n"
"<br/>\n"
"%(current_name)s<br/>\n"
"</html>\n"
msgstr ""
"\n"
"<html>\n"
"Une demande de payement en ligne a été reçu avec erreur dans <i>Diacamma</i>."
"<br/>\n"
"<ul>\n"
" <li><u>Mode:</u> %(mode)s</li>\n"
" <li><u>Document:</u> %(doc)s</li>\n"
" <li><u>Date:</u> %(date)s</li>\n"
" <li><u>Montant:</u> %(amount)s</li>\n"
" <li><u>Payeur:</u> %(payer)s</li>\n"
"<ul>\n"
"<br/>\n"
"%(current_name)s<br/>\n"
"</html>\n"

